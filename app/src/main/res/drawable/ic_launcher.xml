<!--
  CiTV.

  Märket är två öppna bågar med en punkt i mitten. Bågarna läser som ett C,
  punkten som i:ets prick — och tillsammans som en lins, eller som en signal
  som går ut. Två element, inga detaljer som försvinner i 48 dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#03070A"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Yttre båge: den svagare, som en våg som redan gått ut. -->
    <path
        android:pathData="M71.2,29.4 A30,30 0 1 0 71.2,78.6"
        android:strokeColor="#56F0B4"
        android:strokeWidth="4.5"
        android:strokeAlpha="0.55"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Inre båge: själva C:et. -->
    <path
        android:pathData="M64.9,38.4 A19,19 0 1 0 64.9,69.6"
        android:strokeColor="#57E6F2"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Punkten. Ljusast i märket, så blicken landar i mitten. -->
    <path
        android:fillColor="#F5F8FA"
        android:pathData="M54,48.5 a5.5,5.5 0 1 0 0.01,0 z" />
</vector>
