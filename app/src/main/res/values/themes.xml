<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Bara startfönstret. Allt annat ritas av NorrskenTheme i Compose.
      Bakgrunden matchar Palette.background så uppstarten inte blinkar vitt.
    -->
    <style name="Theme.Norrsken" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
